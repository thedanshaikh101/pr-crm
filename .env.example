DATABASE_URL="postgresql://pressdesk:pressdesk@localhost:5432/pressdesk?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"
NEWSROOM_DOMAIN="newsroom.localhost"
SESSION_SECRET="change-me-32-chars-minimum-please-really"
EMAIL_PROVIDER="console"        # console | resend
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_AGENCY_MONTHLY=""
STRIPE_PRICE_AGENCY_ANNUAL=""
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="pressdesk"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio12345"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPERADMIN_EMAILS="dan@changemakerpr.com"
STORAGE_DRIVER="local"          # local | s3  (s3 needs S3_ENDPOINT etc.; local writes to ./.storage)
S3_REGION="us-east-1"
S3_PUBLIC_URL=""                # optional CDN/public bucket base URL
GOOGLE_REDIRECT_URI=""          # optional; defaults to $APP_URL/api/auth/google/callback (must match the Google console)
INBOUND_WEBHOOK_SECRET=""       # header x-inbound-secret on POST /api/webhooks/inbound (reply detection)
IMAP_HOST=""                    # optional IMAP reply detection (worker job reply-check)
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""
INBOX_WEBHOOK_SECRET=""         # header x-inbox-secret on POST /api/webhooks/inbox?account=<slug> (Response Desk)
INBOX_IMAP_HOST=""              # optional shared inbox poller (worker job poll-inbox)
INBOX_IMAP_PORT="993"
INBOX_IMAP_USER=""
INBOX_IMAP_PASS=""
INBOX_ACCOUNT_SLUG=""           # account that owns the polled mailbox
VERIFY_SMTP="0"                 # 1 enables the SMTP RCPT probe in nightly email verification (needs port 25 egress)
